# Required for the local web app
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:5173

# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Uploads and email
UPLOADTHING_TOKEN=replace-with-your-uploadthing-token
RESEND_API_KEY=re_replace_with_your_resend_api_key

# Google OAuth (required by the current auth configuration)
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret

# Optional AI features
GEMINI_API_KEY=

# Stripe billing
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret
STRIPE_ADVENTURER_PRICE_ID=price_replace_with_adventurer_price_id
STRIPE_HERO_PRICE_ID=price_replace_with_hero_price_id

# PartyKit real-time sync
# The app falls back to BETTER_AUTH_SECRET, but set this explicitly for local PartyKit.
PARTYKIT_AUTH_SECRET=
VITE_PARTYKIT_HOST=127.0.0.1:1999

# Optional Upstash Redis rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Mobile builds
# VITE_API_BASE_URL is empty for the web app; set it to the deployed API origin for Capacitor.
VITE_API_BASE_URL=
# Set MOBILE=true only for Capacitor builds; leave it unset for web development.
# MOBILE=true
